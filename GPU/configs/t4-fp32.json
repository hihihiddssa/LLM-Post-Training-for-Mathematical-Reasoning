{
  "protocol": "ass2-v1",
  "seed": 42,
  "models": {
    "tinyllama": "TinyLlama/TinyLlama_v1.1",
    "openllama": "openlm-research/open_llama_3b_v2"
  },
  "methods": [
    "lora",
    "adapterp"
  ],
  "epochs": 2,
  "learning_rate": 0.0003,
  "batch_size": 4,
  "micro_batch_size": 1,
  "cutoff_len": 256,
  "val_set_size": 120,
  "gradient_checkpointing": true,
  "precision": "fp32_base_fp32_adapters",
  "quantization": "none",
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.05,
  "bottleneck_size": 256,
  "eval_steps": 200,
  "save_steps": 200,
  "generation": {
    "do_sample": false,
    "num_beams": 1,
    "max_new_tokens": 256,
    "use_cache": true
  },
  "numeric_tolerance": 0.001,
  "compute_dtype": "float32",
  "precision_reason": "T4 fallback: full FP32 avoids observed FP16 gradient instability. Must pass the assigned-model smoke tests within 16GB before formal use."
}